# Telnet
VLAN_TELNET_USERNAME=username
VLAN_TELNET_PASSWORD=change-me
VLAN_TELNET_SECRET=change-me

# Vendor-local Telnet override for GR-EP-OLT1-4 local-only devices.
# Username defaults to root when omitted; password is required for this vendor.
# VLAN_GR_EP_OLT1_TELNET_USERNAME=root
# VLAN_GR_EP_OLT1_TELNET_PASSWORD=change-me

# Zabbix
VLAN_ZABBIX_URL=https://zabbix.example.com/zabbix
VLAN_ZABBIX_API_TOKEN=change-me
# Optional fallback if token is not used:
# VLAN_ZABBIX_USERNAME=api-user
# VLAN_ZABBIX_PASSWORD=change-me
